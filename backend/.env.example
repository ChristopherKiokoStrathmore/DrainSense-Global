# Copy to backend/.env (git-ignored). Never commit real values.

# --- Django -------------------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ngao-api.example.org
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------------------
# sqlite (default, development) or oracle (Autonomous Database, schema NGAO)
DB_ENGINE=sqlite
# DB_ENGINE=oracle
# DB_DSN=ngaodb_low                       # TNS alias from the wallet's tnsnames.ora
# DB_USER=NGAO
# DB_PASSWORD=
# DB_WALLET_DIR=/opt/ngao/wallet          # unzipped ADB wallet (git-ignored)
# DB_WALLET_PASSWORD=
# DB_SCHEMA=WKSP_NGAO                     # only if the tables live in another schema than DB_USER

# --- Auth (API_CONTRACT §2.0) ----------------------------------------------------------------
USSD_SERVICE_TOKEN=change-me-ussd          # Louisa's ussd/ service
NGAO_API_TOKENS=change-me-apex             # APEX demo controls, scheduler, tests (comma list)
WEBHOOK_SECRET=                            # if set, Africa's Talking callback URLs end with ?k=<secret>

# --- SMS: Africa's Talking (§3) ------------------------------------------------------------------
SMS_BACKEND=console                        # console (logs only) | africastalking | wasiliana (fallback)
AT_USERNAME=sandbox                        # "sandbox" for the sandbox app (SMS show in the AT simulator), else your app username
AT_API_KEY=                                # from the AT dashboard: Settings -> API Key (sandbox and live keys differ)
AT_SENDER_ID=                              # registered alphanumeric sender ID or shortcode; empty = AT's default sender
# AT_SMS_URL=                              # override; default https://api[.sandbox].africastalking.com/version1/messaging
# SMS_DLR_FIELDS={"provider_msg_id":["id"],"status":["status"]}    # extra callback field names (rarely needed)
# Wasiliana fallback (SMS_BACKEND=wasiliana)
# WASILIANA_API_KEY=
# WASILIANA_SENDER_ID=
SMS_DISPATCH=inline                        # inline (background thread) | worker (manage.py sms_worker)
SMS_SIMULATE_SYNTHETIC=true                # is_demo subscribers (fake numbers) never reach the SMS provider
DEMO_PHONES=                               # presenter phones (+2547...): always sent for real, wiped by reset-demo

# --- Alert engine ------------------------------------------------------------------------------
ALERTS_REQUIRE_APPROVAL=true               # officers approve in APEX (Alert Approvals); false = send at once
ALERT_MAX_AGE_HOURS=48
WEEKLY_ROUTINE_CAP=3
# NGAO_TEMPLATE_HAZARDS={"A1":"dry_window","A2":"heavy_rain"}   # ALERT_TEMPLATE.hazard per alert type
# NGAO_TEMPLATE_SEVERITY_ACT=warning
SEND_WELCOME_SMS=true
SEND_REPORT_ACK=true

# --- Reply reader (OCI Generative AI, §2.4) ------------------------------------------------------
REPLY_READER=rules                         # rules (keyword + number) | genai
AI_CONFIDENCE_THRESHOLD=0.7
# OCI_AUTH=config                          # config | instance_principal | resource_principal
# OCI_CONFIG_FILE=~/.oci/config
# OCI_PROFILE=DEFAULT
# OCI_REGION=eu-frankfurt-1
# OCI_COMPARTMENT_ID=ocid1.compartment.oc1..
# OCI_GENAI_MODEL_ID=cohere.command-a-03-2025
