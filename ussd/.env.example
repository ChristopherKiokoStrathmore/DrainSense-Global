# Copy to .env and fill in. Never commit real values.

# USSD gateway: africastalking (default) or wasiliana.
USSD_PROVIDER=africastalking

# Public HTTPS URL the gateway posts to (set as the callback URL of the Africa's Talking USSD channel).
USSD_PUBLIC_URL=https://example.ngrok-free.app/ussd

# Backend contract (docs/API_CONTRACT.md §5). Leave BACKEND_BASE_URL empty to use DevBackend.
BACKEND_BASE_URL=https://backend.example/ngao/v1
USSD_SERVICE_TOKEN=
BACKEND_TIMEOUT_S=4

# Optional shared secret: the callback URL becomes .../ussd?k=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Autonomous Database (USSD_SESSIONS write; SUBSCRIBERS + WARDS read). Empty = in-memory dev store.
DB_USER=NGAO
DB_PASSWORD=
DB_DSN=
DB_WALLET_DIR=
DB_WALLET_PASSWORD=
# Set when DB_USER is not the app schema (e.g. ADMIN working in WKSP_NGAO).
DB_SCHEMA=

# Only with USSD_PROVIDER=wasiliana: payload field names (confirm against docs.wasiliana.com).
WASILIANA_TEXT_MODE=cumulative
WASILIANA_FIELD_SESSION=
WASILIANA_FIELD_PHONE=
WASILIANA_FIELD_TEXT=
WASILIANA_FIELD_SERVICE_CODE=
