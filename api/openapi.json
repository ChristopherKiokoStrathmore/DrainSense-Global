  "components": {
    "schemas": {
      "Contribution": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature",
            "description": "Model column"
          },
          "input": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Input",
            "description": "Value the model saw, after derivation"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution",
            "description": "CatBoost SHAP value in index points"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "input",
          "contribution"
        ],
        "title": "Contribution"
      },
      "DfoFormula": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value",
            "description": "log10(days_inclusive × severity × area_km2)"
          },
          "rounded": {
            "type": "number",
            "title": "Rounded",
            "description": "Rounded to 0.1, as the DFO table stores it"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          },
          "inputs": {
            "$ref": "#/components/schemas/DfoFormulaInputs"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "value",
          "rounded",
          "definition",
          "inputs",
          "note"
        ],
        "title": "DfoFormula"
      },
      "DfoFormulaInputs": {
        "properties": {
          "days_inclusive": {
            "type": "integer",
            "title": "Days Inclusive"
          },
          "severity": {
            "type": "number",
            "title": "Severity"
          },
          "area_km2": {
            "type": "number",
            "title": "Area Km2"
          }
        },
        "type": "object",
        "required": [
          "days_inclusive",
          "severity",
          "area_km2"
        ],
        "title": "DfoFormulaInputs"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeldOutEvent": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id"
          },
          "start_date": {
            "type": "string",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "title": "End Date"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "iso_country_code": {
            "type": "string",
            "title": "Iso Country Code"
          },
          "continent_region": {
            "type": "string",
            "title": "Continent Region"
          },
          "cause_group": {
            "type": "string",
            "title": "Cause Group"
