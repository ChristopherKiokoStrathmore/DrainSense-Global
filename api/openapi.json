    "/api/v1/impact/predict": {
      "post": {
        "tags": [
          "impact model"
        ],
        "summary": "Score one flood event",
        "description": "Returns the estimate, SHAP contributions, and the exact DFO formula value when\n`end_date`, `area_km2` and `severity` are all sent. Required fields per variant are listed\nunder `inputs` in `GET /api/v1/impact/model`.",
        "operationId": "impact_predict_api_v1_impact_predict_post",
        "parameters": [
          {
            "name": "variant",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "brief",
                "no_size"
              ],
              "type": "string",
              "description": "Which CatBoost model scores the event",
              "default": "brief",
              "title": "Variant"
            },
            "description": "Which CatBoost model scores the event"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImpactEventIn"
              },
              "examples": {
                "brief": {
                  "summary": "brief: Kenya, Oct-Nov 2023 (event 5477)",
                  "description": "Every field the brief variant needs, plus severity so the response carries the formula.",
                  "value": {
                    "start_date": "2023-10-15",
                    "end_date": "2023-11-11",
                    "area_km2": 229835,
                    "severity": 1.5,
                    "latitude": -1.503,
                    "longitude": 40.03,
                    "koppen_climate_zone": "Af/Am (Equatorial / Tropical Monsoon)",
                    "continent_region": "Africa",
                    "main_cause": "Heavy rain",
                    "total_precipitation_mm": 793.3,
                    "max_24h_precipitation_mm": 375.3,
                    "total_liquid_rain_mm": 793.3,
                    "snow_melt_equiv_mm": 0.0,
                    "antecedent_7day_precip_mm": 121.5,
                    "estimated_surface_runoff_mm": 502.0,
                    "mean_temp_2m_c": 30.7,
                    "max_temp_2m_c": 35.4,
                    "min_temp_2m_c": 26.9,
                    "max_wind_gust_10m_kmh": 51.4,
                    "min_sea_level_pressure_hpa": 1008.6,
                    "mean_relative_humidity_pct": 78.2,
                    "topsoil_moisture_0_7cm_m3m3": 0.452,
                    "cumulative_et0_evapotranspiration_mm": 145.7
                  }
                },
                "no_size": {
                  "summary": "no_size: no area, end date or severity",
                  "description": "Send with ?variant=no_size. Values are illustrative, not a recorded event.",
                  "value": {
                    "start_date": "2024-04-20",
                    "latitude": -1.28,
                    "longitude": 36.82,
                    "koppen_climate_zone": "Af/Am (Equatorial / Tropical Monsoon)",
                    "continent_region": "Africa",
                    "main_cause": "Heavy rain",
                    "max_24h_precipitation_mm": 80,
                    "antecedent_7day_precip_mm": 120,
                    "mean_temp_2m_c": 19,
                    "max_temp_2m_c": 24,
                    "min_temp_2m_c": 14,
                    "max_wind_gust_10m_kmh": 40,
                    "min_sea_level_pressure_hpa": 1010,
                    "mean_relative_humidity_pct": 85,
                    "topsoil_moisture_0_7cm_m3m3": 0.4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactPrediction"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected. Schema errors return the standard list under `detail`. An event the variant cannot score returns a string, e.g. `variant brief needs: area_km2`."
          }
        }
      }
    },
