{
  "info": {
    "name": "DrainSense API",
    "description": "Flood impact model (CatBoost) and the DrainSense desk. Set baseUrl in the environment. Run the folders in order: Risk map stores cell_id, Drainage log chains report and inspection ids. Schema: api/openapi.json, or /docs on a running server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Impact model",
      "item": [
        {
          "name": "Model card",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/impact/model",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "impact",
                "model"
              ]
            },
            "description": "Parameters, every metric and baseline, data checks, limitations, and the fields each variant requires."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"both variants\", () => pm.expect(Object.keys(body.variants)).to.have.members([\"brief\", \"no_size\"]));",
                  "pm.test(\"brief needs area, no_size does not\", () => {",
                  "  pm.expect(body.inputs.brief.required).to.include(\"area_km2\");",
                  "  pm.expect(body.inputs.no_size.required).to.not.include(\"area_km2\");",
                  "});",
                  "pm.test(\"formula baseline beats the brief model\", () =>",
                  "  pm.expect(body.baselines_temporal_test.dfo_formula.rmse).to.be.below(body.variants.brief.temporal_test.rmse));"
                ]
              }
            }
          ]
        },
        {
          "name": "Predict - brief (Kenya 2023)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/impact/predict?variant=brief",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "impact",
                "predict"
              ],
              "query": [
                {
                  "key": "variant",
                  "value": "brief"
                }
              ]
            },
            "description": "Event 5477, Kenya 15 Oct - 11 Nov 2023. Severity is optional for the model and only feeds dfo_formula.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2023-10-15\",\n  \"end_date\": \"2023-11-11\",\n  \"area_km2\": 229835,\n  \"severity\": 1.5,\n  \"latitude\": -1.503,\n  \"longitude\": 40.03,\n  \"koppen_climate_zone\": \"Af/Am (Equatorial / Tropical Monsoon)\",\n  \"continent_region\": \"Africa\",\n  \"main_cause\": \"Heavy rain\",\n  \"total_precipitation_mm\": 793.3,\n  \"max_24h_precipitation_mm\": 375.3,\n  \"total_liquid_rain_mm\": 793.3,\n  \"snow_melt_equiv_mm\": 0.0,\n  \"antecedent_7day_precip_mm\": 121.5,\n  \"estimated_surface_runoff_mm\": 502.0,\n  \"mean_temp_2m_c\": 30.7,\n  \"max_temp_2m_c\": 35.4,\n  \"min_temp_2m_c\": 26.9,\n  \"max_wind_gust_10m_kmh\": 51.4,\n  \"min_sea_level_pressure_hpa\": 1008.6,\n  \"mean_relative_humidity_pct\": 78.2,\n  \"topsoil_moisture_0_7cm_m3m3\": 0.452,\n  \"cumulative_et0_evapotranspiration_mm\": 145.7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"variant brief\", () => pm.expect(body.variant).to.eql(\"brief\"));",
                  "pm.test(\"formula matches the recorded index 7.0\", () => pm.expect(body.dfo_formula.rounded).to.eql(7.0));",
                  "pm.test(\"SHAP contributions add up to the estimate\", () => {",
                  "  const total = body.expected_value + body.contributions.reduce((s, c) => s + c.contribution, 0);",
                  "  pm.expect(Math.abs(total - body.flood_impact_index)).to.be.below(0.002);",
                  "});",
                  "pm.test(\"log area leads\", () => pm.expect(body.contributions[0].feature).to.eql(\"Log_Area\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Predict - no_size",
