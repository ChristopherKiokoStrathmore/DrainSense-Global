                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"two results\", () => pm.expect(body.count).to.eql(2));",
                  "pm.test(\"smaller area scores lower\", () =>",
                  "  pm.expect(body.results[1].flood_impact_index).to.be.below(body.results[0].flood_impact_index));"
