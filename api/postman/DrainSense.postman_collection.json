              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"variant no_size\", () => pm.expect(body.variant).to.eql(\"no_size\"));",
                  "pm.test(\"no formula without area, end date and severity\", () => pm.expect(body.dfo_formula).to.be.null);",
                  "pm.test(\"reading flags synthetic training weather\", () => pm.expect(body.reading).to.include(\"synthetic\"));"
                ]
              }
            }
          ]
